<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>Emby.Plugins.YouTube</AssemblyName>
    <RootNamespace>Emby.Plugins.YouTube</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>0.1.5</Version>
    <AssemblyVersion>0.1.5.0</AssemblyVersion>
    <FileVersion>0.1.5.0</FileVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Emby loads a bare .dll from its plugin folder; it does not resolve NuGet
         dependencies at runtime, so the plugin must not pull in extra assemblies. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference-only: these ship with the server, so never copy them to output. -->
    <PackageReference Include="MediaBrowser.Server.Core" Version="4.9.1.90" PrivateAssets="all" ExcludeAssets="runtime" />
    <!-- Emby's ILogger exposes ReadOnlyMemory<char> overloads, so the compiler needs System.Memory
         to bind any logger call. The server already ships it at runtime — reference only. -->
    <!-- Must be 4.6.x: MediaBrowser.Model binds against System.Memory assembly version 4.0.2.0,
         and the long-standing 4.5.5 package only carries 4.0.1.2. -->
    <PackageReference Include="System.Memory" Version="4.6.0" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.js" />
    <EmbeddedResource Include="Images\thumb.png" Condition="Exists('Images\thumb.png')" />
  </ItemGroup>

</Project>
